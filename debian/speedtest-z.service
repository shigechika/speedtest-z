[Unit]
Description=speedtest-z - Automated multi-site speed test runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/speedtest-z
ExecStart=/usr/bin/speedtest-z $SPEEDTEST_Z_OPTS
# Interrupted runs exit 130 (SIGINT) / 143 (SIGTERM); treat both as clean stops
SuccessExitStatus=130 143
WorkingDirectory=/var/lib/speedtest-z
User=speedtest-z
Group=speedtest-z
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/speedtest-z /tmp
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
