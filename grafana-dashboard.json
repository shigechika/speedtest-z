    },
    {
      "id": 4,
      "title": "Jitter (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 3,
            "showPoints": "always",
            "spanNulls": 14400000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "min", "mean"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "speedtest_jitter{host=~\"$host\"}",
          "legendFormat": "{{site}}",
          "refId": "A"
        },
        {
          "expr": "speedtest_IPv4_JIT{host=~\"$host\"}",
          "legendFormat": "inonius (IPv4)",
          "refId": "B"
        },
        {
          "expr": "speedtest_IPv6_JIT{host=~\"$host\"}",
